{
  "name": "fluxzero-deploy-action",
  "version": "1.0.0",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc",
    "build": "npm run build:deploy && npm run build:release-marketplace",
    "build:deploy": "ncc build --minify --license licenses.txt",
    "build:release-marketplace": "ncc build src/release-marketplace.ts -o release-marketplace/dist --minify --license licenses.txt",
    "test": "node --test test/*.test.js",
    "ci": "npm run check && npm run build && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.6.3"
  }
}
